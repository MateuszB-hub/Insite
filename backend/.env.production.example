# Copy to backend/.env.production (gitignored). Read ONLY by ./serve.sh,
# layered over .env, so local development (./dev.sh) is unaffected.
# Replace yourname.dev with your real domain everywhere below.

# --- public address ------------------------------------------------------
APP_BASE_URL=https://yourname.dev
CORS_ORIGINS=https://yourname.dev

# --- HTTPS only (Cloudflare Tunnel provides the certificate) --------------
INSECURE_COOKIES=false
# .dev is already HSTS-preloaded by the registry, so this changes nothing
# browsers do not already enforce; it just makes it explicit.
HSTS_ENABLED=true

# --- who can sign up -----------------------------------------------------
# While testing, only people you give this code to can register. Generate:
#   python3 -c "import secrets;print(secrets.token_urlsafe(12))"
# Delete the line to open registration to everyone.
REGISTRATION_CODE=REPLACE_ME

# --- password reset email via Resend --------------------------------------
# Domain added in Resend as mail.yourname.dev (a subdomain keeps the email
# reputation separate from the site). EMAIL_FROM must be on that subdomain.
EMAIL_PROVIDER=smtp
EMAIL_FROM="Insite <no-reply@mail.yourname.dev>"
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_REPLACE_WITH_YOUR_RESEND_API_KEY

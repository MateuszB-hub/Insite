# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
# Postgres is the target; `docker compose up -d` from the repo root starts it.
DATABASE_URL=postgresql+psycopg://insite:CHANGE_ME@localhost:5433/insite

# ---------------------------------------------------------------
# Email (password reset delivery)
# ---------------------------------------------------------------
# console -> prints the message to stdout. Default; no account needed.
# smtp    -> any SMTP server, including Resend / Postmark / SES endpoints.
#            serve.sh refuses to start in production while this is console.
#
# Resend (recommended; free tier 3,000/month, 100/day):
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend
#   SMTP_PASSWORD=<your re_... API key>
#   EMAIL_FROM must be an address on a domain verified in Resend (DNS records).
# Test delivery: python -m app.scripts.send_test_email you@example.com
EMAIL_PROVIDER=console
EMAIL_FROM="Insite <no-reply@yourdomain.com>"
# Used to build the link in the email; must match where users reach the app.
APP_BASE_URL=http://localhost:5173
RESET_TOKEN_TTL_MINUTES=30

# Only needed when EMAIL_PROVIDER=smtp
SMTP_HOST=
# 465 = implicit TLS, 587 = STARTTLS. Both work with Resend/Postmark/SES.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# ---------------------------------------------------------------
# Auth / sessions
# ---------------------------------------------------------------
SESSION_TTL_HOURS=12
# Set true ONLY for local http dev; it drops the Secure flag on the cookie.
INSECURE_COOKIES=false

# ---------------------------------------------------------------
# Data retention
# ---------------------------------------------------------------
# Applicant personal data. 24 months is a common HR default -- a policy
# choice, not a technical one. The purge job enforces it.
RETENTION_DAYS=730
# Audit entries hold only a user id + action, so they are kept longer.
AUDIT_RETENTION_DAYS=1095

# ---------------------------------------------------------------
# OIDC / enterprise SSO (Google Workspace, Entra, Okta, Auth0)
# ---------------------------------------------------------------
# Leave blank to use local password auth. Filling these in switches the
# portal to SSO without code changes.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:5173/auth/callback

# ---------------------------------------------------------------
# Synthesis provider
# ---------------------------------------------------------------
# auto      -> prefer local (Ollama), fall back to mock. Never picks paid.
# ollama    -> force the local model
# anthropic -> force the paid tier (requires ENABLE_PAID_PROVIDERS=true)
# mock      -> deterministic, no model
SYNTHESIS_PROVIDER=auto

# --- Local models (default, free, private) ---
OLLAMA_HOST=http://localhost:11434
# Bare names resolve to a pulled tag, e.g. llama3.1 -> llama3.1:8b
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=300

# --- Paid tier (opt-in) ---
# Master switch. Until this is true, no metered API call can be made,
# even if a key is present and a provider is named explicitly.
ENABLE_PAID_PROVIDERS=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=4096

# ---------------------------------------------------------------
# Search provider
# ---------------------------------------------------------------
# mock (default, no key) | ddg (free, scraper, fragile) | tavily (paid, stable)
SEARCH_PROVIDER=mock

# --- DuckDuckGo (free, no key, but a SCRAPER not an API) ---
# Measured ~8% failure on a 12-query burst from one IP. Dev/demo only.
DDG_BACKEND=duckduckgo   # "auto" fans out to Google/Bing/Brave/etc. -- see README
DDG_MIN_INTERVAL=1.5
DDG_MAX_RETRIES=3
DDG_RESULTS_PER_QUERY=5

# --- Tavily (the production path) ---
# Free: 1,000 credits/month, no card. Then $0.008/credit pay-as-you-go.
# basic = 1 credit/search, advanced = 2. A report runs 3-5 searches.
# Sign up: https://app.tavily.com
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
# Repeat queries within this window are free (in-process cache).
SEARCH_CACHE_TTL_SECONDS=86400

# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------
# Labour-market data sources
# ---------------------------------------------------------------
# Each is independent: whatever is configured goes live, the rest
# degrade to clearly-labelled fallbacks. GET /api/labor/status shows
# current state and the registration URL for anything missing.

# O*NET -- occupations, adjacency, skills ("what would I qualify for")
# Register: https://services.onetcenter.org/developer
# v2 API: a single key sent as X-API-Key.
ONET_API_KEY=

# BLS -- official wage data ("what does it pay")
# NOTE: keyless requests work for CES/LNS but NOT for the OEWS wage
# tables, so this key is required for any wage figure.
# Register: https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# Adzuna -- live postings, top hiring companies, salary distribution/history
# ("who has been hiring, and at what pay")
# Register: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
